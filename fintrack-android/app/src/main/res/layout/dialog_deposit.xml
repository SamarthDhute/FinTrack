<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_dark"
    android:padding="20dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💰 Add Money / Top-Up"
        android:textColor="@color/primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDialogWalletName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Target: Main Bank Account (Current: ₹25,000)"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Amount Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:boxStrokeColor="@color/primary"
        app:hintTextColor="@color/primary"
        android:textColorHint="@color/text_muted">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDepositAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Top-up Amount (₹)"
            android:inputType="numberDecimal"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Quick Amount Chips Horizontal Scroll -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupAmounts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip500"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+₹500"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/surface_dark" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip1000"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+₹1,000"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/surface_dark" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip2000"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+₹2,000"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/surface_dark" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip5000"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+₹5,000"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/surface_dark" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip10000"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+₹10,000"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/surface_dark" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip25000"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+₹25,000"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/surface_dark" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- New Balance Preview Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input_field"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="New Balance Preview:"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvNewBalancePreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹25,000.00"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Reason Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:boxStrokeColor="@color/primary"
        app:hintTextColor="@color/primary"
        android:textColorHint="@color/text_muted">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDepositReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Reason / Tag (e.g. Monthly Salary)"
            android:inputType="textCapWords"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelDeposit"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/text_muted"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmDeposit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Funds"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary"
            app:cornerRadius="10dp" />
    </LinearLayout>

</LinearLayout>
