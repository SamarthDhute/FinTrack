# Environment Variables for FinTrack Backend
DATABASE_URL=postgresql+psycopg://postgres:fintrack_pass@localhost:5432/fintrack_db
APP_ENV=development
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Phase 2 — JWT Authentication
JWT_SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth 2.0 (Optional — leave blank if not using Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:3000

# ── Email Configuration ────────────────────────────────────────────────────────
# Switch provider: "smtp" (Gmail), "brevo" (Brevo API), "resend" (Resend API), or "auto"
EMAIL_PROVIDER=smtp

# Brevo API (Free 300 emails/day, sends to ANY recipient without custom domain)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Resend API (Alternative HTTPS provider)
RESEND_API_KEY=re_your_api_key_here
SMTP_FROM=onboarding@resend.dev

# SMTP Settings (Recommended for local development with Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password

# ── AI Financial Recommendations & Insights ──────────────────────────────────
# Supported providers: "gemini", "openai", "groq", "deepseek", "ollama", "rules", "auto"
AI_PROVIDER=auto
AI_MODEL_NAME=gemini-3.5-flash

# Google Gemini (Free tier from Google AI Studio: https://aistudio.google.com)
GEMINI_API_KEY=

# OpenAI / Groq / DeepSeek / Ollama
OPENAI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1   # Optional for Groq or local Ollama

